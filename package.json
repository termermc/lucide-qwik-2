{
	"name": "lucide-qwik-2",
	"version": "0.0.9",
	"description": "Lucide icon library package for Qwik applications",
	"author": {
		"name": "termer",
		"email": "termer@termer.net",
		"url": "https://github.com/termermc"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/termermc/lucide-qwik-2.git"
	},
	"license": "LICENSE",
	"keywords": [
		"icon",
		"icons",
		"lucide",
		"qwik"
	],
	"main": "./lib/index.js",
	"qwik": "./lib/index.js",
	"sideEffects": false,
	"types": "./lib-types/index.d.ts",
	"exports": {
		"./*": {
			"types": "./lib-types/*.qwik.d.ts",
			"import": "./lib/*.qwik.js"
		}
	},
	"files": [
		"lib",
		"lib-types"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"private": false,
	"type": "module",
	"scripts": {
		"codegen": "node ./script/build-icons.ts",
		"check": "tsc --noEmit",
		"build": "node script/build-all.ts",
		"build.lib": "vite build --mode lib",
		"build.types": "tsc --emitDeclarationOnly",
		"dev": "vite --mode ssr",
		"dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
		"fmt": "prettier --write .",
		"fmt.check": "prettier --check .",
		"release": "rm -rf lib* && npm run build && np",
		"start": "vite --open --mode ssr",
		"qwik": "qwik",
		"test": "echo no tests for now"
	},
	"devDependencies": {
		"@eslint/js": "^10",
		"@qwik.dev/core": "2.0.0-rc.4",
		"@types/node": "^26.6.6",
		"lucide": "^1.64.0",
		"np": "^12.1.1",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vite": "8.3.5"
	}
}
